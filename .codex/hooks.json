{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && exec \"$root\"/tooling/worker/run hook --root \"$root\" --agent codex",
            "timeout": 30,
            "statusMessage": "Loading worker context and edit guidance"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|exec_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && exec \"$root\"/tooling/worker/run hook --root \"$root\" --agent codex",
            "timeout": 30,
            "statusMessage": "Loading worker context and edit guidance"
          }
        ]
      }
    ]
  }
}

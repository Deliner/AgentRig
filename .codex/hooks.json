{
  "description": "AgentRig project hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tooling/worker/run\" hook --root \"$(git rev-parse --show-toplevel)\"",
            "timeout": 30,
            "statusMessage": "Loading worker context and edit guidance"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|exec_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/tooling/worker/run\" hook --root \"$(git rev-parse --show-toplevel)\"",
            "timeout": 30,
            "statusMessage": "Loading worker context and edit guidance"
          }
        ]
      }
    ]
  }
}

failure="$root/.git/codex-commit-failed"
if ! /usr/bin/python3 "$root/tooling/branch_workflow.py" guard-commit; then
    exit 1
fi
if "$root/tooling/check.sh" --staged; then
    rm -f "$failure"
else
    : > "$failure"
    exit 1
fi

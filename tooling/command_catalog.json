{
  "default": {"mode": "list", "description": "List agent commands", "requires": []},
  "list": {"mode": "list", "description": "List agent commands", "requires": []},
  "read": {"mode": "read", "description": "Run argv in a read-only sandbox", "requires": []},
  "write": {"mode": "write", "description": "Run argv with normal repository access", "requires": []},
  "status": {"mode": "command", "description": "Show concise Git status", "argv": ["git", "status", "--short"], "requires": []},
  "diff": {"mode": "command", "description": "Show a Git diff", "argv": ["git", "diff"], "accepts_args": true, "requires": []},

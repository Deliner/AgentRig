  "check-staged": {"mode": "command", "description": "Run the staged-tree gate", "argv": ["./tooling/check.sh", "--staged"], "requires": ["tooling/check.sh"]},
  "test": {"mode": "command", "description": "Run pytest", "argv": ["uv", "run", "--locked", "--project", "tooling", "pytest", "-c", "tooling/pyproject.toml"], "accepts_args": true, "requires": ["tooling/pyproject.toml", "tooling/uv.lock"]},

{
  "type": "object",
  "required": ["profile", "task", "contract"],
  "additionalProperties": false,
  "properties": {
    "profile": {"type": "string"},
    "task": {"type": "string", "minLength": 1},
    "revision": {"type": ["string", "null"]},
    "inputs": {"type": "object", "additionalProperties": {"type": "string"}},
    "contract": {
      "type": "object",
      "required": ["result_schema"],
      "additionalProperties": false,
      "properties": {
        "result_schema": {"type": ["object", "boolean"]},
        "artifacts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    }
  }
}

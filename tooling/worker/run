#!/usr/bin/env bash
# DECISION: D015
# DECISION: D027
set -euo pipefail
source_dir="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$source_dir/../.." && pwd)"
read -r revision < "$root/tooling/distribution/stable.txt"
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || { echo 'Invalid stable revision' >&2; exit 2; }
export WORKER_TARGET_DIR="${WORKER_TARGET_DIR:-$root/.cache/worker}"
export CARGO_TARGET_DIR="$WORKER_TARGET_DIR"
export WORKER_SOURCE_ROOT="${WORKER_SOURCE_ROOT:-$root}"
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$root/.cache/venv}"
binary="$WORKER_SOURCE_ROOT/.cache/development/$revision/.agentrig/bin/agentrig"
if [[ ! -x "$binary" ]]; then
    echo 'Stable AgentRig is not installed. Run just bootstrap; candidate sources are never built by this launcher.' >&2
    exit 2
fi
exec "$binary" "$@"

#!/usr/bin/env bash
# DECISION: D015
# DECISION: D041
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
source_dir="$root/Project"
target="$(printenv WORKER_TARGET_DIR || true)"
if [[ -z "$target" ]]; then target="$root/.cache/worker"; fi
binary="$target/release/agentrig"
export WORKER_TARGET_DIR="$target"
export CARGO_TARGET_DIR="$target"
export WORKER_BINARY="$binary"
export WORKER_SOURCE_ROOT="${WORKER_SOURCE_ROOT:-$root}"
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-$root/.cache/venv}"
signature="$(cd "$source_dir" && find . -type f \( -path './shared/skills/*' -o -name '*.rs' -o -name '*.txt' -o -name '*.json' -o -name '*.yaml' -o -name '*.yml' -o -name Cargo.toml -o -name Cargo.lock \) -print0 | sort -z | xargs -0 sha256sum | sha256sum)"
saved=""
if [[ -f "$target/source-signature" ]]; then read -r saved < "$target/source-signature"; fi
if [[ ! -x "$binary" || "$saved" != "$signature" ]]; then
    mkdir -p "$target"
    (
        flock 9
        cargo +1.98.1 build --manifest-path "$source_dir/Cargo.toml" --target-dir "$target" --release --locked >&2
        printf '%s\n' "$signature" > "$target/source-signature"
    ) 9>"$target/build.lock"
fi
exec "$binary" "$@"

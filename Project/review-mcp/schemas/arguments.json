{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "base",
    "candidate"
  ],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "string",
      "minLength": 1
    },
    "previous_report": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
